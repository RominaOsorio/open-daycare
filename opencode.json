{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "references": {
    "db_schema": {
      "path": "../07-DB-Schema",
      "description": "Schema de base de datos, tablas, columnas y referencias a crear, esto no esta implementado en la base de datos, solo es de referencia"
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": "allow"
  }
}
